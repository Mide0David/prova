# ─────────────────────────────────────────────────
# PROVA — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────

# ── Database ──────────────────────────────────────
# PostgreSQL connection URL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/prova_db?schema=public"

# ── NextAuth ──────────────────────────────────────
# Generate with: openssl rand -base64 32
# REQUIRED — app will crash on startup if missing
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Pusher (Realtime) ─────────────────────────────
# Create a free account at pusher.com → Channels
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"

# Public vars (exposed to client)
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# ── Supabase Storage (File Uploads) ───────────────
# Get from supabase.com → Project Settings → API
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="prova-uploads"

# ── Paystack (Payments) ───────────────────────────
# Get from paystack.com → Settings → API
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# ── App Config ────────────────────────────────────
APP_URL="http://localhost:3000"

# Rate limiting — requests per minute on public diagnostic endpoints
DIAGNOSTIC_RATE_LIMIT_RPM="20"

# ── Email (Optional — Forgot Password) ───────────
# Use any SMTP provider (Resend, SendGrid, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@prova.ng"
